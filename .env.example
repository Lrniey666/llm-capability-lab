# 複製成 .env 後填入。.env 已在 .gitignore，不會進版控。
#
# 同一家可填多把。ask / fallback / Router 失敗時的順序：
#   KEY → KEY2 → KEY3（可再加 KEY4…KEY9）→ 下一家 provider
# 每把金鑰遇 429/5xx 預設再重試 1 次；401 立刻換下一把；400 換下一家。
# 注意：同一帳號／專案下的多把 key，配額通常是共用的。

# https://console.groq.com/keys        （Email 註冊即可，前綴 gsk_）
GROQ_API_KEY=
GROQ_API_KEY2=
GROQ_API_KEY3=

# https://aistudio.google.com/apikey   （Google 帳號，不綁卡就停在免費層）
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=

# https://console.mistral.ai/api-keys  （需手機驗證才會開通 Experiment）
MISTRAL_API_KEY=
MISTRAL_API_KEY2=
MISTRAL_API_KEY3=

# 本機保底：Qwen3.5-4B，排在四家雲端之後。留空＝不納入 Router。
# 先裝 Ollama，再執行：ollama pull qwen3.5:4b
# 程式打的是 Ollama /api/chat，不是任意 Chat Completions 端點。
# LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_API_KEY=ollama
# LOCAL_MODEL=qwen3.5:4b

# iAI Hub  https://www.iai.nkust.edu.tw/apply
# 規格見 reference/iai/iAI_SPEC.txt；預設模型 Furen-large，可用 IAI_MODEL 覆寫。
IAI_API_KEY=
IAI_API_KEY2=
IAI_API_KEY3=
# IAI_MODEL=Furen-large
# IAI_BASE_URL=https://www.iai.nkust.edu.tw/aihub/v1

# HTTP 服務：pip install "llm-capability-lab[serve]"
# LLMCLAB_API_TOKEN=
# LLMCLAB_ALLOW_ANONYMOUS=1

# 研究模組（vision-menu 等）裝到別處時，指回本 repo 根目錄
# LLMCLAB_WORKSPACE=
